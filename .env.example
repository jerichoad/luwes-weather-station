# Root environment untuk docker-compose.yml
# Salin file ini ke .env sebelum menjalankan `docker compose up --build`.

APP_NAME="Luwes Weather Station"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
# Key development saja. Untuk produksi ganti dengan hasil `php artisan key:generate --show`.
APP_KEY=base64:N00DFTZmY6LLrNeBj33MycNVCYRC4xoKgsJPCG2Zx6k=

DB_DATABASE=weather
DB_USERNAME=weather
DB_PASSWORD=weather

# Port di host. Ganti jika bentrok. Di Windows, 8080 bisa masuk rentang yang direservasi
# Hyper-V/WSL (cek: netsh interface ipv4 show excludedportrange protocol=tcp); pakai mis. 18080.
BACKEND_PORT_FORWARD=8080
FRONTEND_PORT_FORWARD=3000
DB_PORT_FORWARD=5433
REDIS_PORT_FORWARD=6380

BCRYPT_ROUNDS=12

DEVICE_KEY_PEPPER=change-me-dev-only

# Key development, bukan secret produksi. Harus sama dengan SIM_DEVICES di simulator.
SEED_DEVICE_KEYS=WS-GRT-001=wsk_dev_grt_aZ3kLp9QmXr2TnYv8sWe4Bc6Hd1F;WS-DPK-001=wsk_dev_dpk_jN7xRt2KqLm9VwYc4Zb6Hs1Ue8Fa3P;WS-BGR-001=wsk_dev_bgr_qW8eRt3YuIo5PaLs2Dh7Fg1Jk4Nm6C

INGEST_MAX_BATCH=500
INGEST_FUTURE_TOLERANCE_S=300
READINGS_MAX_POINTS=2000
CONNECTIVITY_ONLINE_S=300
CONNECTIVITY_OFFLINE_S=900

NEXT_PUBLIC_APP_NAME="Luwes Weather Station Monitoring"
AUTH_COOKIE_NAME=wsm_token
